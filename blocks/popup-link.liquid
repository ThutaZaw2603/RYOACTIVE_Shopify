

{% assign block_settings = block.settings %}
{% assign content_page_url = block_settings.content_page.url %}
{% if block_settings.content_page_view != blank %}
  {% assign content_page_url = content_page_url | append: '?view=' | append: block_settings.content_page_view %}
{% endif %}

<script
  src="{{ 'dialog.js' | asset_url }}"
  type="module"
></script>

{% if block_settings.content_page != blank %}
  <script
    src="{{ 'remote-content.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
  <script
    src="{{ 'size-chart.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
  {% render 'size-chart-styles' %}
  {% if block_settings.show_unit_toggle %}
    <script
      src="{{ 'unit-toggle.js' | asset_url }}"
      type="module"
      fetchpriority="low"
    ></script>
  {% endif %}
{% endif %}

<dialog-component
  class="popup-link"
  {{ block.shopify_attributes }}
>
  <button
    on:click="/showDialog"
    class="button button-unstyled popup-link__button text-left spacing-style {{ block_settings.type_preset }}"
    style="{% render 'spacing-style', settings: block_settings %}"
  >
    {{- block_settings.heading }}
  </button>

  <dialog
    ref="dialog"
    class="popup-link__content dialog-modal color-custom-popover{% if block_settings.behavior == 'drawer' %} popup-link__content--drawer dialog-drawer{% endif %}"
    scroll-lock
    aria-labelledby="popup-dialog-heading"
  >
    <h2
      id="popup-dialog-heading"
      class="visually-hidden"
    >
      {{ block_settings.heading }}
    </h2>
    {% if block_settings.content_page != blank %}
      {% if block_settings.show_unit_toggle %}
        <unit-toggle-component class="popup-link__unit-toggle" data-unit="cm">
          <span class="popup-link__unit-toggle-label">CM</span>
          <button
            type="button"
            class="popup-link__unit-toggle-switch"
            on:click="/toggleUnit"
            aria-pressed="false"
            aria-label="Toggle measurement unit"
          >
            <span class="popup-link__unit-toggle-knob"></span>
          </button>
          <span class="popup-link__unit-toggle-label">IN</span>
        </unit-toggle-component>
      {% endif %}
      <remote-content-component class="popup-link__inner" data-url="{{ content_page_url }}"></remote-content-component>
    {% else %}
      <div class="popup-link__inner">
        {% content_for 'blocks' %}
      </div>
    {% endif %}
    <button
      ref="closeButton"
      on:click="/closeDialog"
      class="button button-unstyled close-button popup-link__close"
      aria-label="{{ 'accessibility.close_dialog' | t }}"
    >
      {{- 'icon-close.svg' | inline_asset_content -}}
    </button>
  </dialog>
</dialog-component>

{% stylesheet %}
  .popup-link__button {
    text-decoration: underline;
  }

  .popup-link__content {
    box-shadow: var(--shadow-popover);
    border: var(--style-border-popover);
    border-radius: var(--style-border-radius-popover);
    background-color: var(--color-background);
    padding: var(--padding-4xl) var(--padding-xl) var(--padding-xl);
    max-width: var(--normal-content-width);
    max-height: var(--modal-max-height);

    @media screen and (min-width: 750px) {
      padding: var(--padding-5xl);
    }
  }

  .popup-link__content[open] {
    animation: modalSlideInTop var(--animation-speed) var(--animation-easing) forwards;
  }

  .popup-link__content.dialog-closing {
    animation: modalSlideOutTop var(--animation-speed) var(--animation-easing) forwards;
  }

  .popup-link__content--drawer {
    position: fixed;
    border-radius: 0;
    width: var(--sidebar-width);
    max-width: 95vw;
    height: 100%;
    margin: 0 0 0 auto;

    @media screen and (min-width: 750px) {
      padding-inline: var(--padding-lg);
    }
  }

  /* Needed to ensure the drawer is full height */
  .popup-link__content--drawer:modal {
    max-height: 100dvh;
  }

  .popup-link__close {
    top: var(--margin-2xs);
    right: var(--margin-2xs);
    opacity: 0.8;
    animation: none;
  }

  /* Injected page content already sits inside the dialog's own padding,
     so cancel its page-width grid margins (from .section > *, used by both
     .section--page-width and the default page template's .page-width-content)
     to avoid double insetting. */
  .popup-link__inner .section > * {
    grid-column: 1 / -1;
  }

  .popup-link__unit-toggle {
    display: flex;
    align-items: center;
    gap: var(--padding-2xs);
    margin-block-end: var(--margin-lg);
    font-weight: bold;
  }

  .popup-link__unit-toggle-switch {
    position: relative;
    width: 40px;
    height: 22px;
    padding: 2px;
    border: none;
    border-radius: 999px;
    background-color: var(--color-foreground);
    cursor: pointer;
  }

  .popup-link__unit-toggle-knob {
    display: block;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background-color: var(--color-background);
    transition: translate var(--animation-speed, 0.2s) ease;
  }

  .popup-link__unit-toggle-switch[aria-pressed='true'] .popup-link__unit-toggle-knob {
    translate: 18px 0;
  }

  .popup-link__inner [data-unit-value='in'] {
    display: none;
  }

  unit-toggle-component[data-unit='in'] ~ .popup-link__inner [data-unit-value='cm'] {
    display: none;
  }

  unit-toggle-component[data-unit='in'] ~ .popup-link__inner [data-unit-value='in'] {
    display: inline;
  }

  /* Pages may paste in tables with a fixed 100%-width layout that only
     fits desktop. Shopify's rich-text renderer already wraps tables in
     .rte-table-wrapper with overflow-x: auto (base.css) - just make sure
     the table itself has room to be wider than its container instead of
     squeezing columns, so that wrapper actually has something to scroll. */
  @media screen and (max-width: 749px) {
    .popup-link__inner table {
      width: auto !important;
      table-layout: auto !important;
    }

    .popup-link__inner table th,
    .popup-link__inner table td {
      width: auto !important;
      white-space: nowrap;
    }
  }
{% endstylesheet %}

