

{% liquid
  assign block_settings = block.settings

  assign card_ratio = 1
  case block_settings.aspect_ratio
    when 'landscape'
      assign card_ratio = '16 / 9'
    when 'portrait'
      assign card_ratio = '4 / 5'
    when 'square'
      assign card_ratio = '1 / 1'
    when 'adapt'
      assign card_ratio = block_settings.image.aspect_ratio
  endcase

  if card_ratio == 0 or card_ratio == blank
    assign card_ratio = 1
  endif
%}

<div class="fabric-card" style="--fabric-card-ratio: {{ card_ratio }};" {{ block.shopify_attributes }}>
  <div class="fabric-card__media">
    {% render 'background-media',
      background_media: 'image',
      background_image: block_settings.image,
      background_image_position: 'cover',
      block: block,
      section: section
    %}
    {% if block_settings.toggle_overlay %}
      {% render 'overlay', settings: block_settings %}
    {% endif %}
  </div>

  <div class="fabric-card__content">
    {% if block_settings.title != blank %}
      <h3 class="fabric-card__title">{{ block_settings.title }}</h3>
    {% endif %}

    {% if block_settings.description != blank %}
      <p class="fabric-card__description">{{ block_settings.description }}</p>
    {% endif %}

    <div class="fabric-card__tags">
      {% for i in (1..3) %}
        {% liquid
          case i
            when 1
              assign tag_icon = block_settings.tag_1_icon
              assign tag_icon_image = block_settings.tag_1_icon_image
              assign tag_label = block_settings.tag_1_label
            when 2
              assign tag_icon = block_settings.tag_2_icon
              assign tag_icon_image = block_settings.tag_2_icon_image
              assign tag_label = block_settings.tag_2_label
            when 3
              assign tag_icon = block_settings.tag_3_icon
              assign tag_icon_image = block_settings.tag_3_icon_image
              assign tag_label = block_settings.tag_3_label
          endcase
        %}
        {% if tag_label != blank %}
          <div class="fabric-card__tag">
            {% render 'icon-or-image',
              icon: tag_icon,
              image_upload: tag_icon_image,
              width: 20,
              class_name: 'fabric-card__tag-icon'
            %}
            <span>{{ tag_label }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .fabric-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    width: 100%;
    aspect-ratio: var(--fabric-card-ratio, 4 / 5);
  }

  .fabric-card__media {
    position: absolute;
    inset: 0;
  }

  .fabric-card__content {
    position: relative;
    z-index: var(--layer-raised, 1);
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    color: var(--color-white, #fff);
  }

  .fabric-card__title {
    margin: 0;
    color: inherit;
  }

  .fabric-card__description {
    margin: 0;
  }

  .fabric-card__tags {
    display: flex;
    flex-wrap: wrap;
    row-gap: 8px;
    column-gap: 24px;
    margin-block-start: 8px;
  }

  .fabric-card__tag {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;
  }

  .fabric-card__tag-icon {
    flex-shrink: 0;
  }
{% endstylesheet %}

